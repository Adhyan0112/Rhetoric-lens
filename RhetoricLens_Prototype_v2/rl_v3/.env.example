# Start here for a deterministic local demo.
LLM_PROVIDER=mock

# Real LLM mode (Groq structured outputs)
# LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=6

# Live microphone mode (Deepgram)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

CONFIDENCE_THRESHOLD=0.75
WINDOW_SECONDS=30
MAX_BUFFER_SENTENCES=20
DUPLICATE_COOLDOWN_SECONDS=8
PENALTY_AD_HOMINEM=8
PENALTY_STRAW_MAN=7
PENALTY_FALSE_DILEMMA=6
PENALTY_CIRCULAR_REASONING=6
PENALTY_SLIPPERY_SLOPE=5
PENALTY_RED_HERRING=5
